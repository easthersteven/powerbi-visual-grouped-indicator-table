{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "txTips",
  "position": {
    "x": 40,
    "y": 100,
    "z": 0,
    "width": 900,
    "height": 480,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Binding order matters",
                    "textStyle": {
                      "fontSize": "13pt",
                      "fontWeight": "bold",
                      "color": "#1F908C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Group by (merged) takes the field whose rows should collapse into one cell. Row columns take the detail field. Values takes your measures, left to right.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#333333"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Deltas must carry an arrow",
                    "textStyle": {
                      "fontSize": "13pt",
                      "fontWeight": "bold",
                      "color": "#1F908C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "A delta cell is coloured from its leading ▲ or ▼ character, so return delta measures as text, for example: IF ( d >= 0, \"▲ \" & FORMAT ( d, \"0.0%\" ), \"▼ \" & FORMAT ( ABS ( d ), \"0.0%\" ) ).",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#333333"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Good direction is per group",
                    "textStyle": {
                      "fontSize": "13pt",
                      "fontWeight": "bold",
                      "color": "#1F908C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The Delta direction field is read from the first row of each group, so keep it constant within a group - bind it to the same field you group by.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#333333"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Avoid",
                    "textStyle": {
                      "fontSize": "13pt",
                      "fontWeight": "bold",
                      "color": "#1F908C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "More than about 2,000 rows (the visual caps the data reduction there), and binding a delta measure that returns a plain number - it will render neutral.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#333333"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
