{
    "dataRoles": [
        { "displayName": "Group by (merged)", "name": "groupBy", "kind": "Grouping", "displayNameKey": "groupBy" },
        { "displayName": "Row columns", "name": "dimensions", "kind": "Grouping", "displayNameKey": "dimensions" },
        { "displayName": "Values (merged)", "name": "values", "kind": "Measure", "displayNameKey": "values" },
        { "displayName": "Delta direction (hidden)", "name": "direction", "kind": "Grouping", "displayNameKey": "direction" },
        { "displayName": "Heatmap switch (optional)", "name": "heatMode", "kind": "Grouping", "displayNameKey": "heatMode" }
    ],
    "objects": {
        "tableStyle": {
            "properties": {
                "headerBg":        { "type": { "fill": { "solid": { "color": true } } } },
                "headerColor":     { "type": { "fill": { "solid": { "color": true } } } },
                "rowAltBg":        { "type": { "fill": { "solid": { "color": true } } } },
                "accent":          { "type": { "fill": { "solid": { "color": true } } } },
                "pillColor":       { "type": { "fill": { "solid": { "color": true } } } },
                "pillBg":          { "type": { "fill": { "solid": { "color": true } } } },
                "good":            { "type": { "fill": { "solid": { "color": true } } } },
                "bad":             { "type": { "fill": { "solid": { "color": true } } } },
                "neutral":         { "type": { "fill": { "solid": { "color": true } } } },
                "fontSize":        { "type": { "numeric": true } },
                "deltaColumnCount":{ "type": { "integer": true } },
                "hideEmptyColumns":{ "type": { "bool": true } },
                "sortByGroup":     { "type": { "bool": true } },
                "heatmap":         { "type": { "bool": true } },
                "heatmapCenter":   { "type": { "numeric": true } },
                "heatmapLow":      { "type": { "fill": { "solid": { "color": true } } } },
                "heatmapMid":      { "type": { "fill": { "solid": { "color": true } } } },
                "heatmapHigh":     { "type": { "fill": { "solid": { "color": true } } } }
            }
        }
    },
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "groupBy": { "max": 1 },
                    "direction": { "max": 1 },
                    "heatMode": { "max": 1 }
                }
            ],
            "table": {
                "rows": {
                    "select": [
                        { "for": { "in": "groupBy" } },
                        { "for": { "in": "values" } },
                        { "for": { "in": "dimensions" } },
                        { "for": { "in": "direction" } },
                        { "for": { "in": "heatMode" } }
                    ],
                    "dataReductionAlgorithm": { "top": { "count": 2000 } }
                }
            }
        }
    ],
    "supportsHighlight": true,
    "tooltips": {
        "supportedTypes": { "default": true, "canvas": true }
    },
    "supportsKeyboardFocus": true,
    "supportsMultiVisualSelection": true,
    "supportsLandingPage": true,
    "privileges": []
}
